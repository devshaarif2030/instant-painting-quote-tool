# Google Apps Script web app URL (Deploy > Web app > /exec URL). Leave empty to run without saving leads.
APPS_SCRIPT_URL=
# Long random string. Must match LEAD_SECRET in the Apps Script project's Script Properties.
LEAD_SECRET=

# Optional: send the homeowner's quote email from your own domain (e.g. Hostinger).
# When set, the app sends it and Apps Script only saves the row and alerts you.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Northfield Painting (demo) <you@yourdomain.com>"
SMTP_REPLY_TO=
